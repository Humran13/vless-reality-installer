#!/usr/bin/env bash
# vless-reality - management command of the BlueSoftKeys VLESS Reality Installer.
# Focused on OUR managed VLESS+REALITY inbound; it does not replace the full 3X-UI manager (`x-ui`).
set -Eeuo pipefail

# Resolve the real location (the command is normally a symlink in /usr/local/bin).
_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
    _dir="$(cd "$(dirname "$_self")" && pwd)"
    _self="$(readlink "$_self")"
    [[ "$_self" == /* ]] || _self="$_dir/$_self"
done
VRI_ROOT_DIR="$(cd "$(dirname "$_self")/.." && pwd)"
VRI_LIB_DIR="$VRI_ROOT_DIR/lib"
unset _self _dir

for _m in common validate os network upstream api state reality modes firewall client output installer repair diagnostics backup update uninstall; do
    # shellcheck source=/dev/null
    . "$VRI_LIB_DIR/$_m.sh"
done
unset _m

trap 'vri_tmp_cleanup' EXIT
trap 'log_err "interrupted"; exit 130' INT TERM
trap 'log_debug "error at line $LINENO: $BASH_COMMAND"' ERR

# ---------------------------------------------------------------- CLI

OPT_MODE="" OPT_PORT="" OPT_SERVER_ADDRESS="" OPT_REALITY_TARGET="" OPT_SNI="" OPT_CLIENT_NAME=""
OPT_GRPC_SERVICE_NAME="" OPT_XHTTP_PATH="" OPT_ALLOW_UNSUPPORTED_OS=0 OPT_PANEL_VERSION=""
OPT_EXPIRE_DAYS=0 OPT_QUOTA_GB=0 OPT_UNINSTALL_LEVEL="" OPT_SELF=0 OPT_REF="" OPT_FORCE=0
OPT_NON_INTERACTIVE=0
CLI_ARGS=()

usage() {
    cat <<EOF
${VRI_PRODUCT} ${VRI_VERSION}

Usage: vless-reality <command> [options]

Commands:
  install             Install official stable 3X-UI + a VLESS REALITY inbound + first client
  menu                Interactive menu
  status              Health summary (versions, mode, service, Xray, port, inbound, clients)
  info [NAME]         Connection details and client share links
  clients             List clients of the managed inbound
  add-client [NAME]   Add a client   (--expire-days N, --quota-gb N)
  remove-client NAME  Remove a client
  enable-client NAME  Enable a client
  disable-client NAME Disable a client
  qr [NAME]           Show a client's share link as a terminal QR code
  logs                Recent wrapper and 3X-UI/Xray logs
  diagnostics         Read-only health checks (no secrets printed)
  backup              Back up the panel database + wrapper state
  restore [FILE]      Restore from a backup (asks for confirmation)
  update              Update 3X-UI to the latest STABLE release (backup, verify, rollback)
  update --self       Update this wrapper from GitHub (--ref REF)
  repair              Repair only what this wrapper manages and finds broken
  uninstall           Remove managed config / wrapper / 3X-UI (--level 1|2|3)
  version             Show versions
  help                This text

Install options:
  --mode tcp|grpc|xhttp        Connection mode (default: tcp; asked interactively)
  --port PORT                  Inbound port (default 443)
  --server-address ADDRESS     Public IPv4/hostname used in client links (default: auto-detect)
  --reality-target HOST:PORT   REALITY target (default: first validated built-in candidate)
  --sni HOST                   SNI / server name (default: target host)
  --client-name NAME           First client name (default: ${DEFAULT_CLIENT_NAME})
  --grpc-service-name NAME     gRPC service name (default: random)
  --xhttp-path PATH            XHTTP path (default: random)
  --allow-unsupported-os       Try on an unlisted OS (no guarantees)
  --panel-version vX.Y.Z       Pin a specific STABLE 3X-UI release (dev builds are never used)

Global options:
  --non-interactive  Never prompt (use defaults / fail)      -y, --yes  Assume "yes" to confirmations
  --verbose          Show details                             -h, --help / --version
EOF
}

_need_val() { # option value
    [[ -n "${2:-}" && "${2:0:2}" != "--" ]] || die "option $1 needs a value" "$VRI_EX_USAGE"
}

parse_args() {
    CLI_ARGS=()
    while (($#)); do
        case "$1" in
            --mode=* | --port=* | --server-address=* | --reality-target=* | --sni=* | --client-name=* | --grpc-service-name=* | --xhttp-path=* | --panel-version=* | --expire-days=* | --quota-gb=* | --level=* | --ref=*)
                set -- "${1%%=*}" "${1#*=}" "${@:2}"
                continue
                ;;
            --mode) _need_val "$1" "${2:-}" && OPT_MODE="$2" && shift ;;
            --port) _need_val "$1" "${2:-}" && OPT_PORT="$2" && shift ;;
            --server-address) _need_val "$1" "${2:-}" && OPT_SERVER_ADDRESS="$2" && shift ;;
            --reality-target) _need_val "$1" "${2:-}" && OPT_REALITY_TARGET="$2" && shift ;;
            --sni) _need_val "$1" "${2:-}" && OPT_SNI="$2" && shift ;;
            --client-name) _need_val "$1" "${2:-}" && OPT_CLIENT_NAME="$2" && shift ;;
            --grpc-service-name) _need_val "$1" "${2:-}" && OPT_GRPC_SERVICE_NAME="$2" && shift ;;
            --xhttp-path) _need_val "$1" "${2:-}" && OPT_XHTTP_PATH="$2" && shift ;;
            --panel-version) _need_val "$1" "${2:-}" && OPT_PANEL_VERSION="$2" && shift ;;
            --expire-days) _need_val "$1" "${2:-}" && OPT_EXPIRE_DAYS="$2" && shift ;;
            --quota-gb) _need_val "$1" "${2:-}" && OPT_QUOTA_GB="$2" && shift ;;
            --level) _need_val "$1" "${2:-}" && OPT_UNINSTALL_LEVEL="$2" && shift ;;
            --ref) _need_val "$1" "${2:-}" && OPT_REF="$2" && shift ;;
            --self) OPT_SELF=1 ;;
            --force) OPT_FORCE=1 ;;
            --allow-unsupported-os) OPT_ALLOW_UNSUPPORTED_OS=1 ;;
            --non-interactive) OPT_NON_INTERACTIVE=1 ;;
            -y | --yes) VRI_ASSUME_YES=1 ;;
            --verbose) VRI_VERBOSE=1 ;;
            -h | --help) CLI_ARGS+=(help) ;;
            --version) CLI_ARGS+=(version) ;;
            --) shift; CLI_ARGS+=("$@"); return 0 ;;
            -*) die "unknown option: $1 (see: vless-reality help)" "$VRI_EX_USAGE" ;;
            *) CLI_ARGS+=("$1") ;;
        esac
        shift
    done
}

# Common prologue for commands that manage an existing setup.
session() {
    vri_require_root
    vri_tmp_init
    vri_detect_interactive
    state_require
    api_session_init
}

show_version() {
    printf '%s %s\n' "$VRI_PRODUCT" "$VRI_VERSION"
    printf '3X-UI (installed): %s   Xray: %s   (wrapper tested with 3X-UI %s)\n' "$(upstream_version 2>/dev/null || echo 'not installed')" "$(upstream_xray_version 2>/dev/null || echo '-')" "$TESTED_UPSTREAM"
}

cmd_logs() {
    vri_require_root
    printf '== wrapper log (%s/vri.log) ==\n' "$VRI_LOG_DIR"
    if [[ -f "$VRI_LOG_DIR/vri.log" ]]; then tail -n 40 "$VRI_LOG_DIR/vri.log"; else echo "(empty)"; fi
    printf '\n== 3X-UI / Xray (journalctl -u x-ui, last 60 lines) ==\n'
    if vri_have journalctl; then
        journalctl -u "$UPSTREAM_SERVICE" -n 60 --no-pager 2>/dev/null | grep -Eiv 'api.?token|password' || true
    else
        echo "journalctl not available"
    fi
}

cmd_menu() {
    vri_require_root
    vri_tmp_init
    vri_detect_interactive
    ((VRI_INTERACTIVE)) || die "the menu needs an interactive terminal" "$VRI_EX_USAGE"
    state_require
    api_session_init
    local c n
    while :; do
        printf '\n%s%s%s  (mode: %s)\n' "$C_BOLD" "$VRI_PRODUCT" "$C_OFF" "$(mode_call "$MODE" label)"
        cat <<'EOF'
   1) Status                 8) Diagnostics
   2) Connection info        9) Backup
   3) List clients          10) Restore
   4) Add client            11) Update 3X-UI (stable)
   5) Remove client         12) Repair
   6) Enable/disable client 13) Logs
   7) QR code               14) Uninstall
   0) Exit
EOF
        vri_ask c "Choose" "0"
        case "$c" in
            1) output_status || true ;;
            2) output_info ;;
            3) client_list ;;
            4)
                vri_ask n "New client name" "$(client_next_default_name)"
                client_create "$n" || true
                ;;
            5)
                client_list
                vri_ask n "Client to remove" ""
                [[ -n "$n" ]] && vri_confirm "Remove client '$n'?" n && client_remove "$n"
                ;;
            6)
                client_list
                vri_ask n "Client name" ""
                if [[ -n "$n" ]]; then
                    if vri_confirm "Enable it? (No = disable)" y; then
                        client_set_enabled "$n" true
                    else
                        client_set_enabled "$n" false
                    fi
                fi
                ;;
            7)
                vri_ask n "Client name" "$(state_get '(.clients // [])[0].email // empty')"
                if [[ -n "$n" ]]; then client_qr "$n" || true; fi
                ;;
            8) diagnostics_run || true ;;
            9) printf 'Backup written: %s\n' "$(backup_create manual)" ;;
            10)
                backup_list
                vri_ask n "Backup file to restore" ""
                [[ -n "$n" ]] && backup_restore "$n"
                ;;
            11) update_panel || true ;;
            12) repair_run || true ;;
            13) cmd_logs ;;
            14)
                uninstall_run || true
                state_exists || return 0
                ;;
            0 | q | quit | exit) return 0 ;;
            *) log_warn "unknown choice" ;;
        esac
    done
}

main() {
    local cmd
    parse_args "$@"
    cmd="${CLI_ARGS[0]:-help}"
    [[ "$OPT_NON_INTERACTIVE" == "1" ]] && VRI_FORCE_NONINTERACTIVE=1
    local -a rest=("${CLI_ARGS[@]:1}")

    case "$cmd" in
        help) usage ;;
        version) show_version ;;
        install)
            vri_detect_interactive
            installer_run
            ;;
        menu) cmd_menu ;;
        status)
            session
            output_status
            ;;
        info)
            session
            output_info "${rest[@]}"
            ;;
        clients)
            session
            client_list
            ;;
        add-client)
            session
            vri_lock
            local name="${rest[0]:-}"
            if [[ -z "$name" ]]; then name="$(client_next_default_name)"; fi
            client_create "$name" "$OPT_EXPIRE_DAYS" "$OPT_QUOTA_GB"
            output_client_block "$name"
            ;;
        remove-client | enable-client | disable-client | qr)
            session
            [[ "$cmd" == "qr" ]] || vri_lock
            local name="${rest[0]:-}"
            if [[ -z "$name" && "$cmd" == "qr" ]]; then name="$(state_get '(.clients // [])[0].email // empty')"; fi
            [[ -n "$name" ]] || die "usage: vless-reality $cmd NAME" "$VRI_EX_USAGE"
            case "$cmd" in
                remove-client)
                    vri_confirm "Remove client '$name'? Its link will stop working." n || die "cancelled" "$VRI_EX_GENERAL"
                    client_remove "$name"
                    ;;
                enable-client) client_set_enabled "$name" true ;;
                disable-client) client_set_enabled "$name" false ;;
                qr) client_qr "$name" ;;
            esac
            ;;
        logs) cmd_logs ;;
        diagnostics)
            session
            diagnostics_run
            ;;
        backup)
            session
            vri_lock
            log_ok "Backup written: $(backup_create manual)"
            ;;
        restore)
            session
            vri_lock
            if [[ -z "${rest[0]:-}" ]]; then
                printf 'Available backups:\n'
                backup_list
                die "usage: vless-reality restore FILE" "$VRI_EX_USAGE"
            fi
            backup_restore "${rest[0]}"
            ;;
        update)
            if ((OPT_SELF)); then
                vri_require_root
                vri_tmp_init
                vri_lock
                update_self
            else
                vri_require_root
                vri_tmp_init
                vri_detect_interactive
                vri_lock
                update_panel
            fi
            ;;
        repair)
            vri_require_root
            vri_tmp_init
            vri_detect_interactive
            vri_lock
            state_require
            REPAIR_ACTIONS=0
            repair_session_init
            repair_run
            ;;
        uninstall)
            vri_detect_interactive
            uninstall_run
            ;;
        *) die "unknown command '$cmd' (see: vless-reality help)" "$VRI_EX_USAGE" ;;
    esac
}

main "$@"
